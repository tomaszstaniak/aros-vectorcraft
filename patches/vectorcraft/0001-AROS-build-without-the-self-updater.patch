From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Wed, 28 Oct 2026 16:33:23 +0100
Subject: [PATCH] AROS: build without the self-updater

Releases for AROS come through the AROS package catalogue, and craft-update's HTTPS stack (hyper, rustls, aws-lc-sys with its C/CMake build) has no AROS build. The updater is left out on target_os = "aros" the way the web build leaves it out; the Updates UI keeps its no-updater branch.
---
 crates/ui-egui/Cargo.toml        |  8 ++++++-
 crates/ui-egui/src/updates_ui.rs | 36 ++++++++++++++++----------------
 2 files changed, 25 insertions(+), 19 deletions(-)

diff --git a/crates/ui-egui/Cargo.toml b/crates/ui-egui/Cargo.toml
index 02de56a76ada62905b91257293eb2b7a5730b316..f25b48c5fccb2c1c7e71320078debd5b51ded4f0 100644
--- a/crates/ui-egui/Cargo.toml
+++ b/crates/ui-egui/Cargo.toml
@@ -53,6 +53,10 @@ log = { workspace = true }
 # Floating panels open in OS windows of their own on the desktop; on the web they stay in the page.
 [target.'cfg(not(target_arch = "wasm32"))'.dependencies]
 craft-ui = { workspace = true, features = ["native-windows"] }
+
+# AROS: no self-update. Releases come through the AROS package catalogue, and the updater's
+# HTTPS stack (hyper, rustls, aws-lc-sys) has no AROS build.
+[target.'cfg(not(any(target_arch = "wasm32", target_os = "aros")))'.dependencies]
 craft-update = { workspace = true }
 
 [target.'cfg(target_arch = "wasm32")'.dependencies]
@@ -63,7 +67,9 @@ web-time = "1"
 # The current user's id (`geteuid`): Preview in Browser uses its temporary folder only when that
 # user owns it (src/dialogs/save_for_web.rs). Already in Cargo.lock (tempfile), so this adds no
 # new crate.
-[target.'cfg(unix)'.dependencies]
+# AROS is a unix-family Rust target without the system calls rustix needs (single user, no
+# uid/gid or ACLs); the code paths that use it are left out there as on non-unix systems.
+[target.'cfg(all(unix, not(target_os = "aros")))'.dependencies]
 rustix = { workspace = true, features = ["std", "process"] }
 
 [dev-dependencies]
diff --git a/crates/ui-egui/src/updates_ui.rs b/crates/ui-egui/src/updates_ui.rs
index 88e6b84a6ccee2d2fad7c3102bb28e9fa192afc7..eeb29a3483e480e928a81bb2afeebafee4619c3a 100644

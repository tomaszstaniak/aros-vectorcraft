From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Wed, 28 Oct 2026 21:07:54 +0100
Subject: [PATCH] AROS host: OpenGL on the Raspberry Pi only on explicit
 request

OpenGL on the Pi has not run on Pi hardware, and under emulation (Mesa's software renderer, no VideoCore) the GPU renderer stopped the whole system. On aarch64 AUTO uses the CPU and logs why, and GPU stops with a message, unless VECTORCRAFT_EXPERIMENTAL_GL is set. The GL path stays in the program.
---
 apps/vectorcraft-aros/src/native.rs | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/apps/vectorcraft-aros/src/native.rs b/apps/vectorcraft-aros/src/native.rs
index 7b394f114e21ad530bec0b4d19097ede6c208322..3c4d27f3c21d7e58f0045dd498b8a51c18e903f3 100644
--- a/apps/vectorcraft-aros/src/native.rs
+++ b/apps/vectorcraft-aros/src/native.rs
@@ -78,6 +78,16 @@ fn fail(message: &str, workbench: bool) -> std::process::ExitCode {
     std::process::ExitCode::from(20)
 }
 
+/// OpenGL on the Raspberry Pi has not been run on Pi hardware, and under emulation (Mesa's
+/// software renderer, no VideoCore) it stopped the whole system. It is only opened when the user
+/// asks for it knowingly.
+const GL_UNTESTED: &str = "OpenGL on the Raspberry Pi is untested on Pi hardware and stopped the system under emulation; \
+set VECTORCRAFT_EXPERIMENTAL_GL=1 to try it anyway";
+
+fn opengl_allowed() -> bool {
+    !cfg!(target_arch = "aarch64") || std::env::var_os("VECTORCRAFT_EXPERIMENTAL_GL").is_some()
+}
+
 // ---------------------------------------------------------------------------------------------
 
 pub fn main() -> std::process::ExitCode {
@@ -166,6 +176,13 @@ pub fn main() -> std::process::ExitCode {
         min_inner_size: Some((640, 400)),
         renderer: match launch.gui {
             Mode::Cpu => egui_aros::RendererRequest::Cpu,
+            Mode::Auto if !opengl_allowed() => {
+                line(&format!("GUI_RENDERER AUTO uses the CPU: {GL_UNTESTED}"));
+                egui_aros::RendererRequest::Cpu
+            }
+            Mode::Gpu if !opengl_allowed() => {
+                return fail(&format!("GUI_RENDERER=GPU: {GL_UNTESTED}. Choose CPU."), wb);
+            }
             Mode::Auto => egui_aros::RendererRequest::Auto,
             Mode::Gpu => egui_aros::RendererRequest::Gpu,
         },

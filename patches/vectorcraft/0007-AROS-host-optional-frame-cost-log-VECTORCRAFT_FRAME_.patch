From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Wed, 28 Oct 2026 18:32:13 +0100
Subject: [PATCH] AROS host: optional frame cost log (VECTORCRAFT_FRAME_LOG)

Averages of egui-aros's per-frame costs (VectorCraft's own work, tessellation, texture upload, rasterization or GL drawing, presentation) every 20 frames, so that the CPU and OpenGL interface renderers can be compared on the same document.
---
 apps/vectorcraft-aros/src/native.rs | 59 ++++++++++++++++++++++++++++-
 1 file changed, 58 insertions(+), 1 deletion(-)

diff --git a/apps/vectorcraft-aros/src/native.rs b/apps/vectorcraft-aros/src/native.rs
index 28188c88fb429df2fbd61eb5947ae9dc59b9bbc3..00e0c5d240ceac124a9794f6eb2b9142313da552 100644
--- a/apps/vectorcraft-aros/src/native.rs
+++ b/apps/vectorcraft-aros/src/native.rs
@@ -150,13 +150,17 @@ pub fn main() -> std::process::ExitCode {
         },
         ..Default::default()
     };
-    let mut host = Host { app, ctx: ctx.clone(), window, renderer_logged: false };
+    let frames = std::env::var_os("VECTORCRAFT_FRAME_LOG").map(|_| FrameStats::default());
+    let mut host = Host { app, ctx: ctx.clone(), window, renderer_logged: false, frames };
     let result = egui_aros::run(options, ctx, &mut host);
     line(&format!("GUI_RENDERER {}", describe()));
 
     // The window is closed. Save the settings, wait for background saves and exports, then let
     // the app (and with it its worker threads' channels) go before main returns: AROS's pthread
     // library waits for every thread when the process exits.
+    if let Some(stats) = &mut host.frames {
+        stats.flush(0, 0);
+    }
     prefs::save_prefs(&host.app);
     vectorcraft_ui_egui::background::wait_all(&mut host.app);
     drop(host);
@@ -185,6 +189,53 @@ struct Host {
     ctx: egui::Context,
     window: Rc<RefCell<Option<egui_aros::WindowHandle>>>,
     renderer_logged: bool,
+    /// With VECTORCRAFT_FRAME_LOG set: frame costs summed over groups of frames, for comparing
+    /// the CPU and OpenGL interface renderers on the same document.
+    frames: Option<FrameStats>,
+}
+
+#[derive(Default)]
+struct FrameStats {
+    count: u32,
+    /// ui (VectorCraft's own work, including document rasterization), tessellate, textures,
+    /// raster (CPU renderer or GL draw), present, in microseconds.
+    sums: [u128; 5],
+    worst_total: u128,
+}
+
+impl FrameStats {
+    const GROUP: u32 = 20;
+
+    fn add(&mut self, r: &egui_aros::FrameReport) {
+        let parts = [r.ui, r.tessellate, r.textures, r.raster, r.present].map(|d| d.as_micros());
+        for (sum, part) in self.sums.iter_mut().zip(parts) {
+            *sum += part;
+        }
+        self.worst_total = self.worst_total.max(parts.iter().sum());
+        self.count += 1;
+        if self.count == Self::GROUP {
+            self.flush(r.width, r.height);
+        }
+    }
+
+    fn flush(&mut self, width: u32, height: u32) {
+        if self.count == 0 {
+            return;
+        }
+        let avg = |i: usize| self.sums[i] as f64 / f64::from(self.count) / 1000.0;
+        let total: f64 = (0..5).map(avg).sum();
+        line(&format!(
+            "frames {} at {width}x{height}: avg ms total {total:.1} (ui {:.1}, tessellate {:.1}, textures {:.1}, raster {:.1}, present {:.1}), worst {:.1}",
+            self.count,
+            avg(0),
+            avg(1),
+            avg(2),
+            avg(3),
+            avg(4),
+            self.worst_total as f64 / 1000.0
+        ));
+        *self = Self::default();
+    }
 }
 
 impl egui_aros::App for Host {
@@ -214,6 +265,12 @@ impl egui_aros::App for Host {
             prefs::save_prefs(&self.app);
         }
     }
+
+    fn frame_done(&mut self, report: &egui_aros::FrameReport, _renderer: &egui_aros::raster::Renderer) {
+        if let Some(stats) = &mut self.frames {
+            stats.add(report);
+        }
+    }
 }
 

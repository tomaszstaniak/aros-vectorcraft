+/// Point VectorCraft's settings at `dir` (the program's own `VectorCraftData`), unless the user
+/// set `VECTORCRAFT_CONFIG_DIR` already. Call in `main` before any other thread starts.
+pub fn set_default_config_dir(dir: &std::path::Path) {
+    if std::env::var_os("VECTORCRAFT_CONFIG_DIR").is_none() {
+        // SAFETY: called on the main thread before the program starts any other thread, so no
+        // thread reads the environment concurrently.
+        unsafe { std::env::set_var("VECTORCRAFT_CONFIG_DIR", dir) };
+    }
+}
+
 #[derive(Default, Debug)]
 pub struct Startup {
     pub workbench: bool,

diff --git a/apps/vectorcraft-aros/src/launch.rs b/apps/vectorcraft-aros/src/launch.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0085b764aecd43ee346e6d7bbf6e061e1dc1cb46
--- /dev/null
+++ b/apps/vectorcraft-aros/src/launch.rs
@@ -0,0 +1,142 @@
+//! The interface renderer choice: Shell argument, Workbench ToolType, default. No platform or GPU
+//! calls here, so the rules are tested on the host.
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Mode {
+    #[default]
+    Cpu,
+    Auto,
+    Gpu,
+}
+
+impl Mode {
+    pub fn parse(value: &str, key: &str) -> Result<Self, String> {
+        match value.trim().to_ascii_uppercase().as_str() {
+            "CPU" => Ok(Self::Cpu),
+            "AUTO" => Ok(Self::Auto),
+            "GPU" => Ok(Self::Gpu),
+            _ => Err(format!("{key}: unknown value \u{201c}{value}\u{201d}; expected CPU, AUTO or GPU")),
+        }
+    }
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Cpu => "CPU",
+            Self::Auto => "AUTO",
+            Self::Gpu => "GPU",
+        }
+    }
+}
+
+/// What the program was started with, after the renderer choice has been taken out.
+#[derive(Debug, Default, PartialEq, Eq)]
+pub struct Launch {
+    pub gui: Mode,
+    /// Where `gui` came from: "argument", "ToolType" or "default".
+    pub source: &'static str,
+    pub help: bool,
+    pub version: bool,
+    /// Documents to open, as given.
+    pub files: Vec<String>,
+}
+
+/// The ToolTypes the program reads from its icon.
+pub const TOOLTYPES: [&str; 1] = ["GUI_RENDERER"];
+
+/// Shell argument > Workbench ToolType > CPU. A Shell start passes no ToolTypes (the icon is not
+/// read), a Workbench start no arguments. Only the value in force is parsed, so a stale ToolType
+/// cannot stop a start whose argument overrides it.
+pub fn parse(args: &[String], tooltypes: &[String]) -> Result<Launch, String> {
+    let mut out = Launch { source: "default", ..Launch::default() };
+    let mut gui = None;
+    let mut it = args.iter();
+    while let Some(arg) = it.next() {
+        if arg == "--" {
+            out.files.extend(it.cloned());
+            break;
+        }
+        let (key, inline) = arg.split_once('=').map_or((arg.as_str(), None), |(k, v)| (k, Some(v)));
+        match key {
+            "--gui-renderer" => {
+                let value = inline.or_else(|| it.next().map(String::as_str)).ok_or("--gui-renderer: missing CPU, AUTO or GPU")?;
+                gui = Some(Mode::parse(value, "--gui-renderer")?);
+            }
+            "--help" | "-h" => out.help = true,
+            "--version" | "-V" => out.version = true,
+            _ if arg.starts_with("--") => return Err(format!("unknown option \u{201c}{arg}\u{201d}; see --help")),
+            _ => out.files.push(arg.clone()),
+        }
+    }
+    if let Some(mode) = gui {
+        out.gui = mode;
+        out.source = "argument";
+        return Ok(out);
+    }
+    for entry in tooltypes {
+        let Some((key, value)) = entry.split_once('=') else { continue };
+        if key.trim().eq_ignore_ascii_case("GUI_RENDERER") {
+            out.gui = Mode::parse(value, "GUI_RENDERER")?;
+            out.source = "ToolType";
+        }
+    }
+    Ok(out)
+}
+
+pub const HELP: &str = "\
+Usage: VectorCraft [--gui-renderer CPU|AUTO|GPU] [FILE...]
+
+  --gui-renderer CPU   draw the interface with the processor (default); no OpenGL is opened
+  --gui-renderer AUTO  use OpenGL when it opens, otherwise the processor (the reason is logged)
+  --gui-renderer GPU   use OpenGL or stop with an error
+  --version            print the version
+
+Workbench: ToolType GUI_RENDERER=CPU|AUTO|GPU in the program's icon. An argument given in the
+Shell takes priority; the icon is not read then. Values ignore letter case.
+
+OpenGL draws the interface and shows the drawing. The drawing itself is always rendered by the
+processor. Settings and the log (VectorCraft.log) are kept in VectorCraftData in the program's
+drawer.";
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn s(v: &[&str]) -> Vec<String> {
+        v.iter().map(|x| x.to_string()).collect()
+    }
+
+    #[test]
+    fn default_is_cpu() {
+        let l = parse(&[], &[]).unwrap();
+        assert_eq!((l.gui, l.source), (Mode::Cpu, "default"));
+    }
+
+    #[test]
+    fn argument_beats_tooltype_and_ignores_its_bad_value() {
+        let l = parse(&s(&["--gui-renderer", "auto", "Work:a b.svg"]), &s(&["GUI_RENDERER=bogus"])).unwrap();
+        assert_eq!((l.gui, l.source), (Mode::Auto, "argument"));
+        assert_eq!(l.files, s(&["Work:a b.svg"]));
+        let l = parse(&s(&["--gui-renderer=gPu"]), &[]).unwrap();
+        assert_eq!(l.gui, Mode::Gpu);
+    }
+
+    #[test]
+    fn tooltype_applies_without_argument() {
+        let l = parse(&[], &s(&["(GUI_RENDERER=GPU)", "gui_renderer=Auto"])).unwrap();
+        assert_eq!((l.gui, l.source), (Mode::Auto, "ToolType"));
+    }
+
+    #[test]
+    fn bad_values_are_errors() {
+        assert!(parse(&s(&["--gui-renderer", "fast"]), &[]).is_err());
+        assert!(parse(&s(&["--gui-renderer"]), &[]).is_err());
+        assert!(parse(&[], &s(&["GUI_RENDERER=fast"])).is_err());
+        assert!(parse(&s(&["--bogus"]), &[]).is_err());
+    }
+
+    #[test]
+    fn double_dash_keeps_names() {
+        let l = parse(&s(&["--", "--gui-renderer=GPU"]), &[]).unwrap();
+        assert_eq!(l.files, s(&["--gui-renderer=GPU"]));
+        assert_eq!(l.gui, Mode::Cpu);
+    }
+}

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Sat, 28 Nov 2026 09:41:16 +0100
Subject: [PATCH] AROS: threads the programs start get 8 MiB stacks

AROS has no guard page below a thread's stack. With std's 2 MiB default, the
thread that opens a file in the background overran its stack on ABIv11 and
never finished: the progress window stayed up and the document never opened.
Both programs set RUST_MIN_STACK to 8 MiB at start unless it is set.
---
 apps/vectorcraft-aros/src/main.rs | 4 ++++
 apps/vectorcraft-cli/src/main.rs  | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/apps/vectorcraft-aros/src/main.rs b/apps/vectorcraft-aros/src/main.rs
index 3c7c1ff3d88e6698c2e30088b9bbbd188fd1e07e..fb8445c57aa177cceaf6957ce9ed268a6afed15c 100644
--- a/apps/vectorcraft-aros/src/main.rs
+++ b/apps/vectorcraft-aros/src/main.rs
@@ -180,6 +180,10 @@ aros_startup::minimum_stack!(16 << 20);
 fn main() -> std::process::ExitCode {
     // Unix-style probes (fonts, /etc/localtime) must not open "insert volume" requesters.
     startup::quiet_dos();
+    // Threads the program starts get 8 MiB stacks unless RUST_MIN_STACK says otherwise. AROS has
+    // no guard page: a worker that outgrows std's 2 MiB default (opening a file in the background,
+    // on ABIv11) runs over memory that is not its own and never finishes.
+    startup::set_default_env("RUST_MIN_STACK", std::path::Path::new("8388608"));
     // ABIv11's C library keeps one saved directory for the whole process and restores it on the
     // main task at exit; whichever task changes directory first decides what is saved. This
     // chdir, before any worker can make one, keeps the main task's own (Workbench start) lock.
diff --git a/apps/vectorcraft-cli/src/main.rs b/apps/vectorcraft-cli/src/main.rs
index faeec0b0ab7d973be7f0e9b47962e5f452a143dc..65a1468dc312fb133bc99ee3d1f4c4ca41c3f3c6 100644
--- a/apps/vectorcraft-cli/src/main.rs
+++ b/apps/vectorcraft-cli/src/main.rs
@@ -207,6 +207,10 @@ fn main() -> ExitCode {
     // requester that stops the command until someone answers it.
     #[cfg(target_os = "aros")]
     aros_startup::quiet_dos();
+    // Other threads (picture decoding, background reads) get 8 MiB stacks too: AROS has no guard
+    // page, and std's 2 MiB default is too small for some of them.
+    #[cfg(target_os = "aros")]
+    aros_startup::set_default_env("RUST_MIN_STACK", std::path::Path::new("8388608"));
     // AROS: where VectorCraft.portable is looked for (settings in VectorCraftData beside the
     // programs), for a standard library without current_exe (the Raspberry Pi's).
     #[cfg(target_os = "aros")]

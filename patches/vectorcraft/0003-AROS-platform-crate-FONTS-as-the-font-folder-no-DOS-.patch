+use std::{env, path::PathBuf, process::Command};
+fn main() {
+    println!("cargo:rerun-if-changed=c/platform.c");
+    for key in ["AROS_GCC", "AROS_AR", "AROS_SDK"] {
+        println!("cargo:rerun-if-env-changed={key}");
+    }
+    if env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("aros") {
+        return;
+    }
+    let out = PathBuf::from(env::var_os("OUT_DIR").expect("Cargo OUT_DIR"));
+    let cc = env::var_os("AROS_GCC").expect("set AROS_GCC");
+    let sdk = env::var("AROS_SDK").expect("set AROS_SDK");
+    let obj = out.join("platform.o");
+    assert!(
+        Command::new(cc)
+            .args([format!("--sysroot={sdk}"), "-O2".into(), "-Wall".into(), "-Werror".into(), "-c".into(), "c/platform.c".into(), "-o".into()])
+            .arg(&obj)
+            .status()
+            .expect("run AROS compiler")
+            .success()
+    );
+    let archive = out.join("libvectorcraft_platform.a");
+    let _ = std::fs::remove_file(&archive);
+    assert!(
+        Command::new(env::var_os("AROS_AR").expect("set AROS_AR")).arg("rcs").arg(archive).arg(obj).status().expect("run AROS archiver").success()
+    );
+    println!("cargo:rustc-link-search=native={}", out.display());
+    println!("cargo:rustc-link-lib=static=vectorcraft_platform");
+    println!("cargo:rustc-link-lib=icon");
+    println!("cargo:rustc-link-lib=intuition");
+}
diff --git a/crates/aros-platform/c/platform.c b/crates/aros-platform/c/platform.c
new file mode 100644
index 0000000000000000000000000000000000000000..141e602aaba12beee5046d026f783e3fa738dcd8
--- /dev/null
+++ b/crates/aros-platform/c/platform.c
@@ -0,0 +1,78 @@
+/* Workbench owns WBenchMsg and its argument locks until CRT startup returns.
+ * We borrow them on the main task only; every returned string is copied into
+ * caller storage. Never ReplyMsg, UnLock a borrowed lock, or retain DiskObject data. */
+#include <aros/startup.h>
+#include <workbench/startup.h>
+#include <workbench/workbench.h>
+#include <dos/dosextens.h>
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/icon.h>
+#include <proto/intuition.h>
+#include <intuition/intuition.h>
+#include <string.h>
+
+int vc_workbench(void) { return WBenchMsg != NULL; }
+
+/* Unix-style probes (font folders, settings folders) name volumes that do not exist on AROS;
+ * DOS would ask the user to insert each one. The program and the threads it starts (which
+ * inherit pr_WindowPtr) get an error instead. */
+void vc_quiet_dos(void) {
+    struct Process *me = (struct Process *)FindTask(NULL);
+    me->pr_WindowPtr = (APTR)-1;
+}
+
+static int wb_path(int index, char *out, int cap) {
+    if (!WBenchMsg || index < 0 || index >= WBenchMsg->sm_NumArgs) return 0;
+    struct WBArg *arg = &WBenchMsg->sm_ArgList[index];
+    if (!NameFromLock(arg->wa_Lock, (STRPTR)out, cap)) return -1;
+    return AddPart((STRPTR)out, (CONST_STRPTR)arg->wa_Name, cap) ? 1 : -1;
+}
+int vc_wb_file(int index, char *out, int cap) { return wb_path(index, out, cap); }
+int vc_tooltype(const char *key, char *out, int cap) {
+    char path[8192];
+    if (!WBenchMsg) return 0;
+    if (wb_path(0, path, sizeof(path)) != 1) return -1;
+    struct DiskObject *icon = GetDiskObject((CONST_STRPTR)path);
+    if (!icon) return -1;
+    const char *value = (const char *)FindToolType(icon->do_ToolTypes, (STRPTR)key);
+    int result = 0;
+    if (value) {
+        size_t len = strlen(value);
+        if (len >= (size_t)cap) result = -1;
+        else { memcpy(out, value, len + 1); result = 1; }
+    }
+    FreeDiskObject(icon);
+    return result;
+}
+/* The program's drawer as a full DOS name. */
+int vc_progdir(char *out, int cap) {
+    BPTR dir = GetProgramDir();
+    if (!dir) return 0;
+    return NameFromLock(dir, (STRPTR)out, cap) ? 1 : -1;
+}
+/* DOS resolves volumes, assigns, colon roots and parent slashes. For a new
+ * save name, resolve its existing drawer and append only the final component. */
+int vc_absolute(const char *name, char *out, int cap) {
+    BPTR lock = Lock((CONST_STRPTR)name, ACCESS_READ);
+    if (lock) {
+        int ok = NameFromLock(lock, (STRPTR)out, cap);
+        UnLock(lock);
+        return ok ? 1 : -1;
+    }
+    const char *file = (const char *)FilePart((CONST_STRPTR)name);
+    size_t prefix = file - name;
+    char drawer[8192];
+    if (!*file || prefix >= sizeof(drawer)) return -1;
+    memcpy(drawer, name, prefix); drawer[prefix] = 0;
+    lock = Lock((CONST_STRPTR)drawer, ACCESS_READ);
+    if (!lock) return -1;
+    int ok = NameFromLock(lock, (STRPTR)out, cap);
+    UnLock(lock);
+    return ok && AddPart((STRPTR)out, (CONST_STRPTR)file, cap) ? 1 : -1;
+}
+void vc_error(const char *message) {
+    struct EasyStruct es = { sizeof(struct EasyStruct), 0, (CONST_STRPTR)"VectorCraft", (CONST_STRPTR)"%s", (CONST_STRPTR)"OK" };
+    IPTR args[] = { (IPTR)message };
+    EasyRequestArgs(NULL, &es, NULL, (RAWARG)args);
+}
diff --git a/crates/aros-platform/src/lib.rs b/crates/aros-platform/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a2895ec173333d71691ec6082924601881d39035
--- /dev/null
+++ b/crates/aros-platform/src/lib.rs
@@ -0,0 +1,161 @@
+//! AROS startup and path bridge for VectorCraft. Unsafe code is isolated here, never in the
+//! engine or the UI. On other systems every function is a plain fallback, so the crate builds and
+//! its tests run on the host.
+#![allow(unsafe_code)]
+use std::path::PathBuf;
+
+#[cfg(target_os = "aros")]
+mod native {
+    use std::ffi::{CString, c_char};
+    unsafe extern "C" {
+        pub fn vc_workbench() -> i32;
+        pub fn vc_quiet_dos();
+        pub fn vc_wb_file(index: i32, out: *mut c_char, cap: i32) -> i32;
+        pub fn vc_tooltype(key: *const c_char, out: *mut c_char, cap: i32) -> i32;
+        pub fn vc_progdir(out: *mut c_char, cap: i32) -> i32;
+        pub fn vc_absolute(name: *const c_char, out: *mut c_char, cap: i32) -> i32;
+        pub fn vc_error(message: *const c_char);
+    }
+    pub fn cstr(s: &str) -> Result<CString, String> {
+        CString::new(s).map_err(|_| "path or setting contains NUL".into())
+    }
+    pub fn read(call: impl FnOnce(*mut c_char, i32) -> i32) -> Result<Option<String>, String> {
+        let mut bytes = vec![0u8; 8192];
+        let result = call(bytes.as_mut_ptr().cast(), bytes.len() as i32);
+        if result == 0 {
+            return Ok(None);
+        }
+        if result < 0 {
+            return Err("AROS could not resolve the startup data or the path (missing drawer, unreadable icon, or path too long)".into());
+        }
+        let end = bytes.iter().position(|&b| b == 0).ok_or("unterminated DOS result")?;
+        bytes.truncate(end);
+        String::from_utf8(bytes).map(Some).map_err(|_| "DOS path is not UTF-8".into())
+    }
+}
+
+/// Make DOS answer a missing volume with an error instead of a requester, for this process and
+/// the threads it starts. Call first thing in `main`.
+pub fn quiet_dos() {
+    #[cfg(target_os = "aros")]
+    // SAFETY: writes the calling process's own pr_WindowPtr on its own task.
+    unsafe {
+        native::vc_quiet_dos();
+    }
+}
+
+#[derive(Default, Debug)]
+pub struct Startup {
+    pub workbench: bool,
+    pub tooltypes: Vec<String>,
+    pub files: Vec<String>,
+}
+
+/// Workbench start data: the requested ToolTypes (`KEY=value`) and the documents passed with the
+/// program, as -nix paths. A Shell start returns the default (no ToolTypes, no files).
+pub fn startup(tooltype_keys: &[&str]) -> Result<Startup, String> {
+    #[cfg(target_os = "aros")]
+    {
+        // SAFETY: read-only CRT global, while main still owns the startup lifetime.
+        if unsafe { native::vc_workbench() } == 0 {
+            return Ok(Startup::default());
+        }
+        let mut out = Startup { workbench: true, ..Startup::default() };
+        for key in tooltype_keys {
+            let c = native::cstr(key)?;
+            // SAFETY: valid strings and owned writable output, copied before DiskObject is freed.
+            if let Some(value) = native::read(|p, n| unsafe { native::vc_tooltype(c.as_ptr(), p, n) })? {
+                out.tooltypes.push(format!("{key}={value}"));
+            }
+        }
+        for i in 1..1024 {
+            // SAFETY: C checks index against the borrowed WBStartup argument array.
+            match native::read(|p, n| unsafe { native::vc_wb_file(i, p, n) })? {
+                Some(path) => out.files.push(dos_to_nix(&path)?),
+                None => return Ok(out),
+            }
+        }
+        Err("too many Workbench documents".into())
+    }
+    #[cfg(not(target_os = "aros"))]
+    {
+        let _ = tooltype_keys;
+        Ok(Startup::default())
+    }
+}
+
+/// The program's drawer as an absolute -nix path (`/Volume/Drawer`).
+pub fn program_dir() -> Result<PathBuf, String> {
+    #[cfg(target_os = "aros")]
+    {
+        // SAFETY: owned writable output buffer.
+        native::read(|p, n| unsafe { native::vc_progdir(p, n) })?
+            .ok_or_else(|| "the program has no drawer".to_string())
+            .and_then(|p| dos_to_nix(&p))
+            .map(PathBuf::from)
+    }
+    #[cfg(not(target_os = "aros"))]
+    std::env::current_exe().map_err(|e| e.to_string())?.parent().map(PathBuf::from).ok_or_else(|| "the program has no folder".into())
+}
+
+/// A name as typed (AmigaDOS: volume, assign, relative, parent `/`) resolved by DOS to an
+/// absolute -nix path. For a name that does not exist yet its drawer must exist.
+pub fn absolute(name: &str) -> Result<PathBuf, String> {
+    #[cfg(target_os = "aros")]
+    {
+        let c = native::cstr(name)?;
+        // SAFETY: input outlives call; DOS receives an owned writable buffer.
+        native::read(|p, n| unsafe { native::vc_absolute(c.as_ptr(), p, n) })?
+            .ok_or_else(|| "path was not resolved".to_string())
+            .and_then(|p| dos_to_nix(&p))
+            .map(PathBuf::from)
+    }
+    #[cfg(not(target_os = "aros"))]
+    std::path::absolute(name).map_err(|e| e.to_string())
+}
+
+/// Report a startup error: standard error, and on AROS a requester (a Workbench start has no
+/// console to show it).
+pub fn show_error(message: &str) {
+    eprintln!("VectorCraft: {message}");
+    #[cfg(target_os = "aros")]
+    if let Ok(c) = native::cstr(message) {
+        // SAFETY: NUL-terminated string, the requester completes before it is freed.
+        unsafe {
+            native::vc_error(c.as_ptr());
+        }
+    }
+}
+
+/// A resolved DOS name (`Volume:rest`) in the -nix path mode the program runs in. No lexical
+/// parent collapsing: Lock/NameFromLock have already resolved it.
+pub fn dos_to_nix(path: &str) -> Result<String, String> {
+    let (volume, rest) = path.split_once(':').ok_or("DOS did not return a volume-qualified path")?;
+    if volume.is_empty() || volume.contains('/') {
+        return Err("invalid DOS volume name".into());
+    }
+    Ok(if rest.is_empty() { format!("/{volume}") } else { format!("/{volume}/{rest}") })
+}
+
+/// A normalized -nix absolute path as a DOS name, for requesters and messages.
+pub fn nix_to_dos(path: &str) -> Result<String, String> {
+    let rest = path.strip_prefix('/').ok_or("expected a normalized -nix absolute path")?;
+    let (volume, rest) = rest.split_once('/').unwrap_or((rest, ""));
+    if volume.is_empty() {
+        return Err("missing volume in -nix path".into());
+    }
+    Ok(format!("{volume}:{rest}"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{dos_to_nix, nix_to_dos};
+    #[test]
+    fn normalized_paths_round_trip() {
+        for p in ["RAM:", "Work:My Pictures/zażółć.svg", "Ram Disk:a.svg"] {
+            assert_eq!(nix_to_dos(&dos_to_nix(p).unwrap()).unwrap(), p);
+        }
+        assert!(dos_to_nix(":bad").is_err());
+        assert!(dos_to_nix("no-volume").is_err());
+    }
+}

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Wed, 28 Oct 2026 17:49:07 +0100
Subject: [PATCH] AROS: let every worker thread end before the program exits

AROS's pthread library waits for every thread when the process exits. VectorCraft for AROS stayed in memory after its window closed whenever the Layers panel had shown thumbnails: the thumbnail worker's sender lives in a thread-local cache of the UI thread, the worker holds the egui context, and thread-local values of the main task are not dropped before exit, so the worker waited for jobs forever.

graphics::release_thread_caches() empties the UI thread's texture caches at once (Layers thumbnails, font samples), so their workers see their channels close; a host calls it after the window has closed. Desktop builds end their threads with the process and are unchanged.

The rasterizer runs without a thread pool on AROS (default_threads() = 0, VECTORCRAFT_RENDER_THREADS still overrides): a pool would outlive the windows the same way, and the AROS systems run exec on one CPU.
---
 crates/render/src/threads.rs               | 5 +++++
 crates/ui-egui/src/font_menu.rs            | 5 +++++
 crates/ui-egui/src/graphics.rs             | 9 +++++++++
 crates/ui-egui/src/panels/layers.rs        | 1 +
 crates/ui-egui/src/panels/layers/thumbs.rs | 5 +++++
 5 files changed, 25 insertions(+)

diff --git a/crates/render/src/threads.rs b/crates/render/src/threads.rs
index 13a833a3b0a49481c8c08ddaf819e1dd5fded28f..59259b20a34e3fd6f59a5242c393d0135fbcc1d8 100644
--- a/crates/render/src/threads.rs
+++ b/crates/render/src/threads.rs
@@ -31,6 +31,11 @@ pub fn default_threads() -> u16 {
         if std::env::var_os("VECTORCRAFT_RENDER_THREADS").is_some() {
             return std::env::var("VECTORCRAFT_RENDER_THREADS").ok().and_then(|v| v.parse().ok()).unwrap_or(0);
         }
+        // AROS: no rasterizer pool. Its threads would outlive the program's windows (pthread waits
+        // for every thread at exit) and the systems run exec on one CPU.
+        if cfg!(target_os = "aros") {
+            return 0;
+        }
         std::thread::available_parallelism().map(|n| (n.get().saturating_sub(1)).min(8) as u16).unwrap_or(0)
     }
 }
diff --git a/crates/ui-egui/src/font_menu.rs b/crates/ui-egui/src/font_menu.rs
index c2303579481aed788de33273956e47904966314b..6efbc1a08295fd3dd0974c811da68c211ec0f586 100644
--- a/crates/ui-egui/src/font_menu.rs
+++ b/crates/ui-egui/src/font_menu.rs
@@ -657,6 +657,11 @@ thread_local! {
     static SAMPLES: crate::graphics::TexCache<Samples> = crate::graphics::TexCache::default();
 }
 
+/// Drop the font samples and the receivers of samples still being made.
+pub(crate) fn release_samples() {
+    SAMPLES.with(|s| drop(s.borrow_mut()));
+}
+
 /// The sample of `family` for a row `height` points high: the selected text set in it (else a
 /// generic sample), white with coverage as alpha (tinted when drawn). Rendered off the UI thread
 /// on native (the worker asks for a frame when it is done), a few per frame; `None` until it is
diff --git a/crates/ui-egui/src/graphics.rs b/crates/ui-egui/src/graphics.rs
index db85972d2ad6c68bd58553828675ede595251e43..ce170c99ede8c5585c8968afd0477bd9f02eb799 100644
--- a/crates/ui-egui/src/graphics.rs
+++ b/crates/ui-egui/src/graphics.rs
@@ -59,6 +59,15 @@ pub(crate) fn forget_textures() {
     EPOCH.with(|e| e.set(e.get().wrapping_add(1)));
 }
 
+/// Empty this thread's texture caches now, not at their next use, so the worker threads some of
+/// them own (Layers thumbnails, font samples) see their channels close and end. For hosts whose
+/// threads must all end before the program can exit (AROS): call after the window has closed.
+pub fn release_thread_caches() {
+    forget_textures();
+    crate::panels::layers::release_thumbs();
+    crate::font_menu::release_samples();
+}
+
 /// A per-thread cache holding textures (thumbnails, previews, samples). Textures belong to the
 /// egui context they were uploaded to, so the cache goes back to `T::default()` when the UI moves
 /// to another one ([`forget_textures`]). Used like the `RefCell` it wraps.
diff --git a/crates/ui-egui/src/panels/layers.rs b/crates/ui-egui/src/panels/layers.rs
index 9c118a329bf9d0529e4ce16570c081195b53afa7..1d4d561ab07c76d56e53a92f6508381c5bf7fbe1 100644
--- a/crates/ui-egui/src/panels/layers.rs
+++ b/crates/ui-egui/src/panels/layers.rs
@@ -68,6 +68,7 @@ use rows::{drag_ghost, key, rename_id, resolve_click, row};
 #[cfg(test)]
 use thumbs::THUMBS;
 pub(crate) use thumbs::{ThumbSource, node_arc, real_thumb, thumb_options};
+pub(crate) use thumbs::release as release_thumbs;
 
 /// Width of the eye and the lock columns.
 const COLUMN: f32 = 25.0;
diff --git a/crates/ui-egui/src/panels/layers/thumbs.rs b/crates/ui-egui/src/panels/layers/thumbs.rs
index cd98502129176ee111420c378df8049fe884b45a..095b6b9d7b1675226398feeaa48c3ef2b4980ce6 100644
--- a/crates/ui-egui/src/panels/layers/thumbs.rs
+++ b/crates/ui-egui/src/panels/layers/thumbs.rs
@@ -62,6 +62,11 @@ thread_local! {
     pub(super) static THUMBS: crate::graphics::TexCache<Thumbs> = crate::graphics::TexCache::default();
 }
 
+/// Drop the thumbnails and their worker thread (see `graphics::release_thread_caches`).
+pub(crate) fn release() {
+    THUMBS.with(|t| drop(t.borrow_mut()));
+}
+
 /// The most row thumbnails kept: past it the ones drawn longest ago go.
 const MAX_THUMBS: usize = 512;
 

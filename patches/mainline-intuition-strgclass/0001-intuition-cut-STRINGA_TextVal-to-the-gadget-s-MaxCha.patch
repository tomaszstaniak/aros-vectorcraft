From b75e72e5ea753c4000d3f7de0651f383e719eac1 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Wed, 28 Oct 2026 20:03:52 +0100
Subject: [PATCH] intuition: cut STRINGA_TextVal to the gadget's MaxChars

strgclass copied STRINGA_TextVal into the edit buffer with strcpy(), at OM_NEW and at OM_SET. The buffer holds MaxChars bytes including the terminating NUL (allocated by the class, or given with STRINGA_Buffer), so a text of MaxChars characters or more was written past its end.

asl.library hands the file requester's pattern to such a gadget with MaxChars 257. A program that opened a file requester with a longer ASLFR_InitialPattern (a long list of file name extensions) damaged the memory after that buffer. On pc-x86_64 a 300-character pattern ended in an "Illegal instruction" Software Failure in Kickstart code once the requester was closed; on the native Raspberry Pi system the next allocation stopped with "TLSF free-list corruption at REMOVE_HEADER", and the damaged block header held bytes of the pattern.

The text is now cut to MaxChars - 1 characters, as STRINGA_LongVal already is. Texts that fit are stored as before.

Test: developer/debug/test/intuition/strgtextval creates gadgets with STRINGA_Buffer and MaxChars 16, followed by guard bytes, for texts of 0, 5, 15, 16 and 300 characters, sets each text again with SetAttrs(), and checks the stored length and the guard bytes.
---
 developer/debug/test/intuition/mmakefile.src |   3 +-
 developer/debug/test/intuition/strgtextval.c | 108 +++++++++++++++++++
 rom/intuition/strgclass.c                    |  19 +++-
 3 files changed, 127 insertions(+), 3 deletions(-)
 create mode 100644 developer/debug/test/intuition/strgtextval.c

diff --git a/developer/debug/test/intuition/mmakefile.src b/developer/debug/test/intuition/mmakefile.src
index 9c094874ca..20e870cad9 100644
--- a/developer/debug/test/intuition/mmakefile.src
+++ b/developer/debug/test/intuition/mmakefile.src
@@ -21,7 +21,8 @@ FILES := \
     scrollerwin \
     compflicker \
     windowinputregion \
-    windowinputdrop
+    windowinputdrop \
+    strgtextval
 
 EXEDIR := $(AROS_TESTS)/intuition
 
diff --git a/developer/debug/test/intuition/strgtextval.c b/developer/debug/test/intuition/strgtextval.c
new file mode 100644
index 0000000000..e6150e4ba0
--- /dev/null
+++ b/developer/debug/test/intuition/strgtextval.c
@@ -0,0 +1,108 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+
+    Desc: A text given to a strgclass gadget with STRINGA_TextVal, at OM_NEW
+          and with OM_SET, must be stored whole when it fits into
+          STRINGA_MaxChars bytes and cut to MaxChars - 1 characters when it
+          does not, and nothing may be written past the edit buffer. The
+          buffer is the caller's (STRINGA_Buffer), followed by guard bytes
+          that are checked afterwards. ASL's file requester hands its
+          pattern to such a gadget, so a pattern longer than 256 characters
+          overwrote the memory after the gadget's buffer. The guard area is
+          longer than the longest text, so an unfixed gadget is detected
+          without damaging anything else.
+
+    Usage: strgtextval
+    Result: prints PASS and returns 0, or prints FAIL and returns 20.
+*/
+
+#include <proto/exec.h>
+#include <proto/intuition.h>
+#include <intuition/gadgetclass.h>
+#include <intuition/classes.h>
+#include <stdio.h>
+#include <string.h>
+
+#define MAXCHARS 16
+#define LONGTEXT 300
+#define GUARD    (LONGTEXT + 16)
+
+static UBYTE buffer[MAXCHARS + GUARD];
+
+static int check(const char *when, int len, Object *gad, const char *text)
+{
+    int expect = len < MAXCHARS ? len : MAXCHARS - 1;
+    STRPTR val = NULL;
+    int i;
+
+    GetAttr(STRINGA_TextVal, gad, (IPTR *)&val);
+    if (val != (STRPTR)buffer)
+    {
+        printf("FAIL %s, %d characters: TextVal %p is not the given buffer %p\n",
+               when, len, val, buffer);
+        return 1;
+    }
+    for (i = MAXCHARS; i < MAXCHARS + GUARD; i++)
+    {
+        if (buffer[i] != 0xA5)
+        {
+            printf("FAIL %s, %d characters: guard byte %d after the buffer was overwritten\n",
+                   when, len, i - MAXCHARS);
+            return 1;
+        }
+    }
+    if (strlen((char *)buffer) != expect || strncmp((char *)buffer, text, expect) != 0)
+    {
+        printf("FAIL %s, %d characters: buffer holds %lu characters, expected %d\n",
+               when, len, (unsigned long)strlen((char *)buffer), expect);
+        return 1;
+    }
+    printf("ok %s, %d characters: %d stored\n", when, len, expect);
+    return 0;
+}
+
+static int run(int len)
+{
+    char text[LONGTEXT + 1];
+    Object *gad;
+    int i, fail = 0;
+
+    for (i = 0; i < len; i++)
+        text[i] = 'a' + i % 26;
+    text[len] = '\0';
+    memset(buffer, 0xA5, sizeof(buffer));
+
+    gad = NewObject(NULL, STRGCLASS,
+                    STRINGA_Buffer, (IPTR)buffer,
+                    STRINGA_MaxChars, MAXCHARS,
+                    STRINGA_TextVal, (IPTR)text,
+                    TAG_DONE);
+    if (!gad)
+    {
+        printf("FAIL: could not create the gadget\n");
+        return 1;
+    }
+    fail |= check("OM_NEW", len, gad, text);
+
+    memset(buffer, 0xA5, sizeof(buffer));
+    buffer[0] = '\0';
+    if (len > 0)
+        text[0] = 'Z';
+    SetAttrs(gad, STRINGA_TextVal, (IPTR)text, TAG_DONE);
+    fail |= check("OM_SET", len, gad, text);
+
+    DisposeObject(gad);
+    return fail;
+}
+
+int main(void)
+{
+    static const int lengths[] = { 0, 5, MAXCHARS - 1, MAXCHARS, LONGTEXT };
+    int i, fail = 0;
+
+    for (i = 0; i < sizeof(lengths) / sizeof(lengths[0]); i++)
+        fail |= run(lengths[i]);
+
+    printf("%s\n", fail ? "FAIL" : "PASS");
+    return fail ? 20 : 0;
+}
diff --git a/rom/intuition/strgclass.c b/rom/intuition/strgclass.c
index 5875c251af..fc8e30556b 100644
--- a/rom/intuition/strgclass.c
+++ b/rom/intuition/strgclass.c
@@ -28,6 +28,21 @@
 #define SFLG_WORKBUF_ALLOCATED  (1 << 3)
 #define SFLG_UNDOBUF_ALLOCATED  (1 << 4)
 
+/* Copy a text into the edit buffer. MaxChars is the buffer's size including
+   the terminating NUL, so a longer text is cut to MaxChars - 1 characters. */
+static void set_buffer_text(struct StringInfo *StrInfo, CONST_STRPTR text)
+{
+    LONG len = strlen(text);
+
+    if (StrInfo->MaxChars <= 0)
+        return;
+    if (len >= StrInfo->MaxChars)
+        len = StrInfo->MaxChars - 1;
+
+    memcpy(StrInfo->Buffer, text, len);
+    StrInfo->Buffer[len] = '\0';
+}
+
 static void set_buffer_str(struct StringInfo *StrInfo)
 {
     char  buf[64];
@@ -105,7 +120,7 @@ STATIC IPTR strg_set(Class *cl, struct Gadget * g, struct opSet *msg)
                 {
                     /* OM_NEW STRINGA_TextVal is handled in strg_new! */
 
-                    strcpy(data->StrInfo.Buffer, (STRPTR)tidata ? (STRPTR)tidata : (STRPTR)"");
+                    set_buffer_text(&data->StrInfo, (STRPTR)tidata ? (STRPTR)tidata : (STRPTR)"");
                     g->Activation &= ~GACT_LONGINT;
                     retval = 1UL;
                     notify = TRUE;
@@ -310,7 +325,7 @@ IPTR StrGClass__OM_NEW(Class *cl, Object * o, struct opSet *msg)
         textval = (STRPTR)GetTagData(STRINGA_TextVal, 0, msg->ops_AttrList);
         if (textval)
         {
-            strcpy(data->StrInfo.Buffer, textval);
+            set_buffer_text(&data->StrInfo, textval);
             D(bug("strgclass:Initializing string gadget to text value %s\n", textval));
             g->Activation &= ~GACT_LONGINT;
         }
-- 

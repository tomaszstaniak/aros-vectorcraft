if [ "$grub_platform" = "efi" ]; then
menuentry "AROS64 with framebuffer Gfx" {
    multiboot2 /boot/pc/bootstrap.xz ATA=32bit nomonitors  $bootstrap_flags 
    module2 /boot/pc/kernel.xz
    module2 /boot/pc/aros-bsp.pkg.xz
    module2 /boot/pc/aros-acpi.pkg.xz
    module2 /boot/aros-base.pkg.xz
    module2 /boot/aros-fs.pkg.xz
    module2 /boot/poseidon.pkg.xz
}

menuentry "AROS64 with framebuffer Gfx (slow ATA)" {
    multiboot2 /boot/pc/bootstrap.xz ATA=nodma nomonitors  $bootstrap_flags 
    module2 /boot/pc/kernel.xz
    module2 /boot/pc/aros-bsp.pkg.xz
    module2 /boot/pc/aros-acpi.pkg.xz
    module2 /boot/aros-base.pkg.xz
    module2 /boot/aros-fs.pkg.xz
    module2 /boot/poseidon.pkg.xz
}
else
menuentry "AROS64 with VGA @ 640x480-4bpp" {
    multiboot2 /boot/pc/bootstrap.xz novesa ATA=32bit nomonitors  $bootstrap_flags 
    set gfxpayload=text
    module2 /boot/pc/kernel.xz
    module2 /boot/pc/aros-bsp.pkg.xz
    module2 /boot/pc/aros-acpi.pkg.xz
    module2 /boot/aros-base.pkg.xz
    module2 /boot/aros-fs.pkg.xz
    module2 /boot/poseidon.pkg.xz
}

menuentry "AROS64 with VGA @ 640x480-4bpp (slow ATA)" {
    multiboot2 /boot/pc/bootstrap.xz novesa ATA=nodma nomonitors  $bootstrap_flags 
    set gfxpayload=text
    module2 /boot/pc/kernel.xz
    module2 /boot/pc/aros-bsp.pkg.xz
    module2 /boot/pc/aros-acpi.pkg.xz
    module2 /boot/aros-base.pkg.xz
    module2 /boot/aros-fs.pkg.xz
    module2 /boot/poseidon.pkg.xz
}
fi

if [ "$grub_platform" = "efi" ]; then
    set bl_path="/efi/BOOT/grub"
    test -e $bl_path
    insmod all_video
    set vesa_supported=false
    set bootstrap_flags="forceusbpower"
else
    set bl_path="/boot/grub"
    insmod all_video
    set vesa_supported=true
    bootstrap_flags=
fi

if loadfont $bl_path/fonts/unicode.pf2 ; then
    	insmod gfxterm
    	set gfxmode=640x480
    	terminal_output gfxterm
    	insmod png
    	background_image $bl_path/splash.png
fi

# Timeout for menu
set timeout=5

# Set default boot entry as Native Gfx
set default=0

menuentry "AROS64 with native Gfx" {
    multiboot2 /boot/pc/bootstrap.xz ATA=32bit $bootstrap_flags 
    module2 /boot/pc/kernel.xz
    module2 /boot/pc/aros-bsp.pkg.xz
    module2 /boot/pc/aros-acpi.pkg.xz
    module2 /boot/aros-base.pkg.xz
    module2 /boot/aros-fs.pkg.xz
    module2 /boot/poseidon.pkg.xz
}

if [ "$vesa_supported" = "true" ]; then
menuentry "AROS64 with VESA Gfx @ 640x480-8bpp" {
    multiboot2 /boot/pc/bootstrap.xz vesa=640x480x8 ATA=32bit nomonitors $bootstrap_flags 
    module2 /boot/pc/kernel.xz
    module2 /boot/pc/aros-bsp.pkg.xz
    module2 /boot/pc/aros-acpi.pkg.xz
    module2 /boot/aros-base.pkg.xz
    module2 /boot/aros-fs.pkg.xz
    module2 /boot/poseidon.pkg.xz
}

menuentry "AROS64 with VESA Gfx @ 800x600-8bpp" {
    multiboot2 /boot/pc/bootstrap.xz vesa=800x600x8 ATA=32bit nomonitors $bootstrap_flags 
    module2 /boot/pc/kernel.xz
    module2 /boot/pc/aros-bsp.pkg.xz
    module2 /boot/pc/aros-acpi.pkg.xz
    module2 /boot/aros-base.pkg.xz
    module2 /boot/aros-fs.pkg.xz
    module2 /boot/poseidon.pkg.xz
}


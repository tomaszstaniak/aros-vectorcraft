.KEY RUNDIR/A
.BRA [
.KET ]
; VectorCraft smoke run: CLI, GUI starts, a scripted edit saved, read back and reopened.
; Unpack the payload to RAM:vc, then: Execute RAM:vc/run-smoke <results directory>
FailAt 21
Protect RAM:vc/vectorcraft-cli +e
Protect RAM:vc/VectorCraft +e
SetEnv RUST_LOG info
Echo "start" >[RUNDIR]/start.txt
RAM:vc/vectorcraft-cli --version >[RUNDIR]/cli-version.txt
Echo $RC >[RUNDIR]/cli-version.rc
RAM:vc/vectorcraft-cli info RAM:vc/shapes.svg >[RUNDIR]/cli-info.txt
Echo $RC >[RUNDIR]/cli-info.rc
RAM:vc/vectorcraft-cli convert RAM:vc/shapes.svg RAM:vc/shapes.png --scale 2 >[RUNDIR]/cli-png.txt
Echo $RC >[RUNDIR]/cli-png.rc
RAM:vc/vectorcraft-cli convert RAM:vc/shapes.svg RAM:vc/shapes.pdf >[RUNDIR]/cli-pdf.txt
Echo $RC >[RUNDIR]/cli-pdf.rc
RAM:vc/vectorcraft-cli convert RAM:vc/shapes.svg RAM:vc/shapes.vectorcraft >[RUNDIR]/cli-vc.txt
Echo $RC >[RUNDIR]/cli-vc.rc
; Write over the file just written: an existing destination must be replaced.
RAM:vc/vectorcraft-cli convert RAM:vc/shapes.vectorcraft RAM:vc/shapes.vectorcraft >[RUNDIR]/cli-vc2.txt
Echo $RC >[RUNDIR]/cli-vc2.rc
RAM:vc/vectorcraft-cli convert RAM:vc/shapes.vectorcraft RAM:vc/back.svg >[RUNDIR]/cli-back.txt
Echo $RC >[RUNDIR]/cli-back.rc
RAM:vc/vectorcraft-cli convert RAM:vc/shapes.svg RAM:vc/shapes.eps >[RUNDIR]/cli-eps.txt
Echo $RC >[RUNDIR]/cli-eps.rc
RAM:vc/vectorcraft-cli convert RAM:vc/missing.svg RAM:vc/x.png >[RUNDIR]/cli-missing.txt
Echo $RC >[RUNDIR]/cli-missing.rc
RAM:vc/vectorcraft-cli mcp <RAM:vc/mcp-in.txt >[RUNDIR]/cli-mcp.txt
Echo $RC >[RUNDIR]/cli-mcp.rc
Echo "cli done" >[RUNDIR]/cli-done.txt
; GUI: version, a start with a file, the scripted edit, the saved file reopened.
RAM:vc/VectorCraft --version >[RUNDIR]/gui-version.txt
Echo $RC >[RUNDIR]/gui-version.rc
Avail FLUSH >[RUNDIR]/avail0.txt
RAM:vc/VectorCraft --window 900x600 --screenshot RAM:vc/shot1.png --screenshot-frames 12 RAM:vc/shapes.svg
Echo $RC >[RUNDIR]/shot1.rc
Avail FLUSH >[RUNDIR]/avail1.txt
RAM:vc/VectorCraft --window 900x600 --test-steps RAM:vc/steps.json RAM:vc/shapes.svg
Echo $RC >[RUNDIR]/steps.rc
Avail FLUSH >[RUNDIR]/avail2.txt
RAM:vc/vectorcraft-cli info RAM:vc/gui-saved.vectorcraft >[RUNDIR]/gui-saved-info.txt
Echo $RC >[RUNDIR]/gui-saved-info.rc
RAM:vc/VectorCraft --window 900x600 --screenshot RAM:vc/shot2.png --screenshot-frames 12 RAM:vc/gui-saved.vectorcraft
Echo $RC >[RUNDIR]/shot2.rc
Avail FLUSH >[RUNDIR]/avail3.txt
List RAM:vc ALL >[RUNDIR]/list.txt
Copy RAM:vc/shapes.png [RUNDIR]/shapes.png
Copy RAM:vc/shapes.pdf [RUNDIR]/shapes.pdf
Copy RAM:vc/back.svg [RUNDIR]/back.svg
Copy RAM:vc/gui-saved.vectorcraft [RUNDIR]/gui-saved.vectorcraft
Copy RAM:vc/shot1.png [RUNDIR]/shot1.png
Copy RAM:vc/shot2.png [RUNDIR]/shot2.png
Copy RAM:vc/steps-a.png [RUNDIR]/steps-a.png
Copy RAM:vc/steps-b.png [RUNDIR]/steps-b.png
Copy RAM:vc/VectorCraftData/logs/#? [RUNDIR]/
Copy RAM:vc/VectorCraftData/ui.json [RUNDIR]/ui.json
Echo "done" >[RUNDIR]/done.txt
